{
  "name": "geotandem",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k 'tsx watch backend/index.ts' 'vite --host 0.0.0.0'",
    "data:build": "tsx scripts/build-data.ts && tsx scripts/build-location-data.ts",
    "build": "tsc --noEmit && vite build && esbuild backend/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server.js",
    "start": "node dist/server.js",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^3.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "lucide-react": "^0.468.0",
    "d3-geo": "^3.1.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/d3-geo": "^3.1.0",
    "@types/topojson-client": "^3.1.0",
    "@types/geojson": "^7946.0.16",
    "@types/topojson-specification": "^1.0.5",
    "typescript": "~5.8.3",
    "tsx": "^4.19.0",
    "vite": "^6.3.0",
    "@vitejs/plugin-react": "^4.4.0",
    "esbuild": "^0.25.0",
    "concurrently": "^9.1.0",
    "eslint": "^9.25.0",
    "@eslint/js": "^9.25.0",
    "typescript-eslint": "^8.31.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.5.0",
    "@playwright/test": "^1.51.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "2.0.2",
    "flag-icons": "7.3.2"
  }
}
